                            <span style="color:white;"><span style="color:var(--ebc-gold);">●</span> Mercado Cambiario</span>
                            <span id="market-status" style="color: var(--success); font-size: 11px; padding: 3px 8px; background: rgba(16,185,129,0.2); border-radius: 10px;">Conectado API</span>
