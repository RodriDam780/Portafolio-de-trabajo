                    <div class="module-card glass-card" onclick="abrirModalPresupuesto()">
                        <div class="icon-wrapper">📊</div><div>Presupuesto</div>
                    </div>
                    <div class="module-card glass-card" onclick="abrirModalInversiones()">
                        <div class="icon-wrapper">🚀</div><div>Proyecciones</div>
                    </div>
                    <div class="module-card glass-card" onclick="abrirModalProgreso()">
                        <div class="icon-wrapper">🎯</div><div>Mi Diagnóstico</div>
                    </div>
                </div>

                <div class="dynamic-list">
                    <div class="dynamic-item glass-card" onclick="mostrarConsejoCompleto()">
                        <div class="dynamic-content">
                            <h4>💡 Insight Financiero</h4>
                            <p id="texto-consejo-dia">Cargando análisis de hoy...</p>
                        </div>
                        <div class="dynamic-arrow">›</div>
                    </div>

                    <div class="dynamic-item glass-card" onclick="mostrarGlosarioCompleto()">
                        <div class="dynamic-content">
                            <h4>📖 Concepto Clave</h4>
                            <p id="texto-glosario-dia">Cargando base de datos...</p>
                        </div>
                        <div class="dynamic-arrow">›</div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div id="miModal" class="modal-overlay" onclick="cerrarModalFondo(event)">
        <div class="modal-content">
            <span class="close-btn" onclick="cerrarModal()">&times;</span>
            <h2 id="modal-titulo"></h2>
            <div id="modal-texto"></div>
        </div>
    </div>

    <script>
        const diaSemana = new Date().getDay();

        function toggleVisibilidad(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.innerText = "🙈";
            } else {
                input.type = "password";
                icon.innerText = "👁️";
            }
        }

        const consejosDiarios = [
            "Auditoría dominical: Revisa tus suscripciones (Netflix, Spotify). Cancela lo que no usaste este mes.",
            "Lunes de Acción: Automatiza el 10% de tu sueldo a una cuenta de ahorro en cuanto lo recibas.",
            "Martes de Deudas: Usa el método 'Bola de Nieve'. Paga la deuda más pequeña primero para ganar tracción emocional.",
            "Miércoles de Mercado: La inflación es el enemigo invisible. Dinero debajo del colchón es dinero perdiendo valor.",
            "Jueves de Control: Aplica la regla de las 24 horas. Si quieres comprar algo no esencial, espera un día.",
            "Viernes de Fuga: Cuidado con el 'gasto hormiga' de fin de semana. Esos $50 diarios impactan tu potencial de inversión.",
            "Sábado de Capital: Investiga instrumentos de bajo riesgo como CETES para proteger tu fondo de emergencia."
        ];

        const glosarioDiario = [
            { termino: "Tasa de Referencia", definicion: "Porcentaje que el Banco Central cobra a bancos comerciales por prestarles dinero. Define el costo del crédito a nivel nacional." },
            { termino: "Inflación", definicion: "Aumento sostenido de precios. Reduce el poder adquisitivo de la moneda a lo largo del tiempo." },
            { termino: "C.A.T.", definicion: "Costo Anual Total. Medida estandarizada que incluye tasa de interés, comisiones y anualidad de un crédito." },
            { termino: "Interés Compuesto", definicion: "La reinversión de los intereses generados. Es el motor matemático para el crecimiento exponencial del capital." },
            { termino: "AFORE", definicion: "Institución financiera privada que administra e invierte los fondos de retiro de los trabajadores." },
            { termino: "Liquidez", definicion: "Velocidad y facilidad con la que un activo o inversión puede convertirse en efectivo sin pérdida de valor." },
            { termino: "Diversificación", definicion: "Estrategia de gestión de riesgos que mezcla distintas inversiones dentro de un portafolio." }
        ];

        function cambiarPantalla(pantallaId) {
            document.querySelectorAll('.pantalla').forEach(el => { el.classList.remove('activa-flex'); el.classList.remove('activa-block'); });
            const nueva = document.getElementById(pantallaId);
            document.querySelectorAll('.error-msg, .success-msg').forEach(el => el.style.display = 'none');
            pantallaId === 'main-screen' ? nueva.classList.add('activa-block') : nueva.classList.add('activa-flex');
        }

        document.getElementById('formulario-registro').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('reg-email').value.trim().toLowerCase();
            if(localStorage.getItem(email)) { document.getElementById('reg-error').style.display = 'block'; return; }
            const data = {
                nombre: document.getElementById('reg-nombre').value.trim(),
                apellido: document.getElementById('reg-apellido').value.trim(),
                password: document.getElementById('reg-password').value
            };
            localStorage.setItem(email, JSON.stringify(data));
            alert('¡Cuenta Ultra activada! Bienvenido al futuro financiero.');
            document.getElementById('formulario-registro').reset();
            cambiarPantalla('login-screen');
        });

        document.getElementById('formulario-login').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim().toLowerCase();
            const password = document.getElementById('login-password').value;
            const usuario = JSON.parse(localStorage.getItem(email));

            if(usuario && usuario.password === password) {
                document.getElementById('login-error').style.display = 'none';
                iniciarDashboard(usuario.nombre, usuario.apellido);
                cambiarPantalla('main-screen');
                document.getElementById('formulario-login').reset();
            } else { document.getElementById('login-error').style.display = 'block'; }
        });

        document.getElementById('formulario-recuperacion').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('rec-email').value.trim().toLowerCase();
            const nuevaPassword = document.getElementById('rec-new-password').value;
            const usuarioData = localStorage.getItem(email);

            if(usuarioData) {
                const usuario = JSON.parse(usuarioData);
                usuario.password = nuevaPassword;
                localStorage.setItem(email, JSON.stringify(usuario));
                document.getElementById('rec-error').style.display = 'none';
                document.getElementById('rec-success').style.display = 'block';
                setTimeout(() => { document.getElementById('formulario-recuperacion').reset(); document.getElementById('rec-success').style.display = 'none'; cambiarPantalla('login-screen'); }, 2000);
            } else {
                document.getElementById('rec-error').style.display = 'block';
                document.getElementById('rec-success').style.display = 'none';
            }
        });

        function confirmarCerrarSesion() {
            const html = `<div style="text-align:center;"><p style="font-size:16px; color:var(--text-muted); margin-bottom: 25px;">¿Finalizar sesión de forma segura y bloquear el panel?</p><div style="display:flex; justify-content:space-between; gap:15px;"><button class="btn-primary btn-mitad" style="background:#333; color:white; box-shadow:none;" onclick="cerrarModal()">Cancelar</button><button class="btn-primary btn-mitad" style="background:var(--danger); color:white; box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);" onclick="ejecutarCierreSesion()">Sí, salir</button></div></div>`;
            abrirModal("Cerrar Sesión", html);
        }

        function ejecutarCierreSesion() { cerrarModal(); document.getElementById('sidebar').classList.remove('abierto'); cambiarPantalla('login-screen'); }

        function iniciarDashboard(nombre, apellido) {
            document.getElementById('sidebar-nombre-usuario').innerText = `${nombre} ${apellido}`;
            document.getElementById('avatar-inicial').innerText = nombre.charAt(0).toUpperCase();
            const opcionesFecha = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const fechaString = new Date().toLocaleDateString('es-MX', opcionesFecha);
            document.getElementById('display-date').innerText = fechaString.charAt(0).toUpperCase() + fechaString.slice(1);
            document.getElementById('texto-consejo-dia').innerText = consejosDiarios[diaSemana];
            document.getElementById('texto-glosario-dia').innerHTML = `<b style="color:var(--ebc-gold);">${glosarioDiario[diaSemana].termino}:</b> <span style="color:var(--text-muted);">${glosarioDiario[diaSemana].definicion.substring(0, 60)}...</span>`;
            cargarAPIs();
            setTimeout(() => { document.getElementById('sidebar').classList.add('abierto'); }, 300);
        }

        async function cargarAPIs() {
            const cajaDatos = document.getElementById('api-data');
            try {
                const resDivisas = await fetch('https://open.er-api.com/v6/latest/USD');
                const datosDivisas = await resDivisas.json();
                const mxn = datosDivisas.rates.MXN.toFixed(2);
                const eurMxn = (datosDivisas.rates.MXN / datosDivisas.rates.EUR).toFixed(2);
                const resCripto = await fetch('https://api.coindesk.com/v1/bpi/currentprice.json');
                const datosCripto = await resCripto.json();
                const btcUsd = datosCripto.bpi.USD.rate_float.toLocaleString('en-US', {style: 'currency', currency: 'USD'});

                cajaDatos.innerHTML = `<div class="market-item"><p>🇺🇸 USD / MXN</p><span>$${mxn}</span></div><div class="market-item"><p>🇪🇺 EUR / MXN</p><span>$${eurMxn}</span></div><div class="market-item" style="grid-column: span 2; text-align:center;"><p>₿ Bitcoin (BTC)</p><span style="color: #00ffc6; font-size: 24px;">${btcUsd}</span></div>`;
            } catch (error) {
                cajaDatos.innerHTML = "<p style='color: var(--danger); font-size:13px;'>Servidores ocupados. Reintentando conexión...</p>";
                document.getElementById('market-status').innerText = "Offline";
                document.getElementById('market-status').style.background = "rgba(239, 68, 68, 0.2)";
                document.getElementById('market-status').style.color = "var(--danger)";
            }
        }

        function toggleMenu() { document.getElementById('sidebar').classList.toggle('abierto'); }

        const modal = document.getElementById('miModal');
        function abrirModal(titulo, htmlStr) { document.getElementById('modal-titulo').innerText = titulo; document.getElementById('modal-texto').innerHTML = htmlStr; modal.style.display = 'flex'; }
        function cerrarModal() { modal.style.display = 'none'; }
        function cerrarModalFondo(e) { if (e.target === modal) cerrarModal(); }

        function moduloIntroduccion() {
            abrirModal("Módulo 1: Fundamentos del Capital", `<div style="text-align:left;"><p style="color:var(--text-muted); font-size:15px;">El dinero es un sistema de reglas. Si no las conoces, jugarás en desventaja. Entender cómo se mueve la economía básica te protegerá de crisis estructurales.</p><div class="step-box"><h3>Conceptos Clave:</h3><ul><li><b>Inflación:</b> El impuesto silencioso.</li><li><b>Tasa de Interés:</b> El costo de alquilar dinero en el tiempo.</li><li><b>Liquidez vs Rendimiento:</b> A mayor disponibilidad inmediata (liquidez), menor margen de ganancia (rendimiento).</li></ul></div></div>`);
        }

        function moduloDesarrollo() {
            abrirModal("Módulo 2: Apalancamiento", `<div style="text-align:left;"><p style="color:var(--text-muted); font-size:15px;">El crédito corporativo y personal funciona como apalancamiento. Es destructivo si se usa para consumo, pero poderoso si se usa para generar más ingresos (deuda buena).</p><div class="step-box"><h3>Reglas de Oro:</h3><ul><li>Conviértete en "Totalero": Paga el 100% de la deuda antes del corte para financiarse gratis.</li><li>Evalúa siempre el CAT (Costo Anual Total), no te dejes engañar por la tasa nominal.</li><li>Gestión de AFORE: El interés compuesto a 40 años definirá tu vejez.</li></ul></div></div>`);
        }

        function moduloGanancia() {
            abrirModal("Módulo 3: Creación de Riqueza", `<div style="text-align:left;"><p style="color:var(--text-muted); font-size:15px;">Para vencer el efecto inflacionario, el capital debe estar en constante movimiento y crecimiento.</p><div class="step-box"><h3>Vehículos de Inversión Seguros:</h3><ul><li><b>Deuda Gubernamental (CETES):</b> Riesgo casi nulo. Respaldado por el país.</li><li><b>SOFIPOS:</b> Altas tasas con exenciones fiscales atractivas.</li><li><b>ETFs Indexados (Ej. S&P 500):</b> Comprar participaciones de las 500 empresas más sólidas de EE.UU.</li></ul></div><button class="btn-primary" onclick="abrirModalInversiones()">Ejecutar Simulador de Rendimiento</button></div>`);
        }

        function abrirModalPresupuesto() {
            abrirModal("Estrategia Táctica: Presupuesto", `<div style="text-align:left;"><p style="color:var(--text-muted); font-size:15px;">Un presupuesto corporativo o personal no es una restricción, es un plan táctico de asignación de recursos.</p><div class="step-box"><h3>Estructura 50/30/20</h3><ul><li><b>50% Operación (Necesidades):</b> Renta, servicios básicos, alimentación.</li><li><b>30% Discrecional (Deseos):</b> Estilo de vida y entretenimiento.</li><li><b>20% Crecimiento (Ahorro/Inversión):</b> Creación de patrimonio.</li></ul></div><button class="btn-primary" onclick="abrirModalAhorros()">Abrir Herramienta de Asignación</button></div>`);
        }

        function abrirModalAhorros() {
            abrirModal("Simulador de Flujo de Caja", `<div class="input-group"><label>Ingreso Neto Mensual (MXN):</label><input type="number" id="inputSueldo" class="input-interactivo" placeholder="Ej. 15000"></div><button class="btn-primary" onclick="calcularDistribucion()">Calcular Asignación Óptima</button><div id="box-resultado-ahorro" class="resultado-box"></div>`);
        }

        function calcularDistribucion() {
            const ingreso = parseFloat(document.getElementById('inputSueldo').value);
            const box = document.getElementById('box-resultado-ahorro');
            if(ingreso > 0) {
                box.innerHTML = `<p style="color:white; margin:0 0 15px 0; font-weight:600;">Límites de gasto sugeridos:</p><div style="display:flex; justify-content:space-between; margin-bottom:8px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:8px;"><span style="color:var(--text-muted);">🛡️ Operación (50%)</span> <b style="color:white;">$${(ingreso*0.5).toLocaleString('es-MX', {minimumFractionDigits: 2})}</b></div><div style="display:flex; justify-content:space-between; margin-bottom:8px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:8px;"><span style="color:var(--text-muted);">☕ Discrecional (30%)</span> <b style="color:white;">$${(ingreso*0.3).toLocaleString('es-MX', {minimumFractionDigits: 2})}</b></div><div style="display:flex; justify-content:space-between; margin-top:15px; font-size:18px;"><span style="color:var(--ebc-gold); font-weight:800;">🚀 Inversión (20%)</span> <b style="color:var(--success);">$${(ingreso*0.2).toLocaleString('es-MX', {minimumFractionDigits: 2})}</b></div>`;
                box.classList.add('activo');
            } else { alert("Ingresa un monto válido mayor a 0."); }
        }

        function abrirModalInversiones() {
            abrirModal("Motor de Interés Compuesto", `<p style="color:var(--text-muted); font-size:14px;">Simulación conservadora basada en Tasa Libre de Riesgo (CETES) al ~11% anualizado.</p><div class="input-group"><label>Capital Base (MXN):</label><input type="number" id="invCapital" class="input-interactivo" placeholder="Ej. 50000"></div><div class="input-group"><label>Horizonte de Inversión (Años):</label><input type="number" id="invAnios" class="input-interactivo" placeholder="Ej. 10"></div><button class="btn-primary" onclick="calcularInteresCompuesto()">Generar Proyección</button><div id="box-resultado-inv" class="resultado-box"></div>`);
        }

        function calcularInteresCompuesto() {
            const capital = parseFloat(document.getElementById('invCapital').value);
            const anios = parseInt(document.getElementById('invAnios').value);
            const box = document.getElementById('box-resultado-inv');
            const tasa = 0.11;

            if(capital > 0 && anios > 0) {
                const montoFinal = capital * Math.pow((1 + tasa), anios);
                const gananciaPura = montoFinal - capital;
                box.innerHTML = `<p style="color:var(--text-muted); margin-bottom:5px;">Valor del portafolio en <b>${anios} años</b>:</p><p style="font-size:32px; color:var(--success); font-weight:800; margin:10px 0; text-shadow: 0 0 10px rgba(16,185,129,0.3);">$${montoFinal.toLocaleString('es-MX', {minimumFractionDigits: 2})}</p><p style="color:#aaa; font-size:13px; margin:0;">Inyección de Capital: $${capital.toLocaleString('es-MX', {minimumFractionDigits: 2})}</p><p style="color:var(--ebc-gold); font-size:13px; margin-top:5px; font-weight:bold;">Intereses Generados: +$${gananciaPura.toLocaleString('es-MX', {minimumFractionDigits: 2})}</p>`;
                box.classList.add('activo');
            } else { alert("Ingresa valores numéricos válidos."); }
        }

        function abrirModalProgreso() {
            abrirModal("Métricas de Control", `<div class="input-group"><label>Autoevaluación de control financiero (1 al 10):</label><input type="number" id="diagScore" class="input-interactivo" min="1" max="10" placeholder="Ingresa un número (ej. 7)"></div><button class="btn-primary" onclick="evaluarDiagnostico()">Emitir Diagnóstico</button><div id="box-resultado-diag" class="resultado-box"></div>`);
        }

        function evaluarDiagnostico() {
            const score = parseInt(document.getElementById('diagScore').value);
            const box = document.getElementById('box-resultado-diag');
            if(score >= 1 && score <= 10) {
                let mensaje = ""; let color = ""; let bg = "";
                if(score >= 8) { mensaje = "Nivel Óptimo. Estás en fase de acumulación. Enfócate en la diversificación de activos."; color = "var(--success)"; bg = "rgba(16,185,129,0.1)"; }
                else if(score >= 5) { mensaje = "Nivel Medio. Asegura tu fondo de emergencia (3-6 meses de gastos) antes de invertir agresivamente."; color = "var(--ebc-gold)"; bg = "rgba(234, 160, 21, 0.1)"; }
                else { mensaje = "Nivel de Alerta. Frena deudas de consumo, consolida créditos y audita tus gastos hormiga inmediatamente."; color = "var(--danger)"; bg = "rgba(239, 68, 68, 0.1)"; }
                box.style.background = bg; box.style.borderColor = color;
                box.innerHTML = `<h3 style="color:${color}; margin:0; font-size:16px;">${mensaje}</h3><p style="margin-top:10px; color:var(--text-muted); font-size:13px;">Recomendación: Completa los módulos de la Academia.</p>`;
                box.classList.add('activo');
            }
        }

        function mostrarConsejoCompleto() { abrirModal("Insight del Día", `<div style="padding:25px; font-size:18px; text-align:center; background:var(--glass-bg); border:1px solid var(--ebc-gold); border-radius:12px; color:white; line-height:1.5;">${consejosDiarios[diaSemana]}</div>`); }
        function mostrarGlosarioCompleto() { const dato = glosarioDiario[diaSemana]; abrirModal("Glosario Financiero", `<div style="text-align:left;"><h2 style="color:var(--ebc-gold); margin-bottom:15px; font-size:24px; border:none;">${dato.termino}</h2><p style="font-size:16px; line-height:1.6; color:var(--text-light);">${dato.definicion}</p></div>`); }
    </script>
</body>
</html>
