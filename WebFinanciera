                </script>
            </div>
        </div>

        <div class="layout">
            <nav id="sidebar" class="glass-card" style="border-radius: 0; border-top: none; border-bottom: none; border-left: none;">
                <div class="sidebar-info">
                    <strong id="sidebar-nombre-usuario">Alumno</strong><br>
                    <span style="font-size: 12px; color: #10b981;">● En línea</span>
                </div>
               
                <div class="sidebar-section-title">Academia</div>
                <a onclick="moduloIntroduccion()">Introducción al Dinero</a>
                <a onclick="moduloDesarrollo()">Crédito y AFORES</a>
                <a onclick="moduloGanancia()">Estrategias de Inversión</a>
               
                <div class="sidebar-section-title">Herramientas Pro</div>
